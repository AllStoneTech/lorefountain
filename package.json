        "title": "World View: How to Use This View",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showScriptsViewHelp",
        "title": "Scripts View: How to Use This View",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showContinuityViewHelp",
        "title": "Continuity View (Pro): How to Use This View",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showEntityGraphHelp",
        "title": "Entity Graph (Pro): How to Use This Feature",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showStoryBibleHelp",
        "title": "Story-Bible Export (Pro): How to Use This Feature",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showBBCRadioScriptHelp",
        "title": "BBC Radio Drama Export (Pro): How to Use This Feature",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showCueSheetHelp",
        "title": "SFX/Cue-Sheet Export (Pro): How to Use This Feature",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showShotListHelp",
        "title": "Shot List Export (Pro): How to Use This Feature",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showAssetManifestHelp",
        "title": "Asset Manifest Editor: How to Use This Editor",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showStoryCardHelp",
        "title": "Story Card Editor: How to Use This Editor",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showStoryOverviewHelp",
        "title": "Story Overview Editor: How to Use This Editor",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.sendFeedback",
        "title": "Send Feedback",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.showTelemetryQueue",
        "title": "Show Telemetry Queue",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.clearTelemetryOptIn",
        "title": "Disable Telemetry",
        "category": "LoreFountain"
      }
    ],
    "customEditors": [
      {
        "viewType": "lorefountain.storyOverview",
        "displayName": "LoreFountain Story Overview",
        "selector": [
          {
            "filenamePattern": "**/world/OVERVIEW.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "lorefountain.storyCard",
        "displayName": "LoreFountain Story Card",
        "selector": [
          {
            "filenamePattern": "**/world/*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "lorefountain.assetManifest",
        "displayName": "LoreFountain Asset Manifest",
        "selector": [
          {
            "filenamePattern": "**/assets/manifests/audio.json"
          },
          {
            "filenamePattern": "**/assets/manifests/characters.json"
          },
          {
            "filenamePattern": "**/assets/manifests/locations.json"
          },
          {
            "filenamePattern": "**/assets/manifests/objects.json"
          },
          {
            "filenamePattern": "**/assets/manifests/voice.json"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "LoreFountain",
      "properties": {
        "lorefountain.hover.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a Story Card preview on hover over a recognized entity/glossary mention in `.fountain` scripts. Disable if you'd rather rely on another extension's hover."
        },
        "lorefountain.completion.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer entity/glossary name autocomplete after typing `[[` in scripts and world Markdown files (Spec §6, §13.2)."
        },
        "lorefountain.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Share anonymous feature-usage data (which commands and views you use, your license tier, extension version, and editor/OS) to help prioritize development. Off by default, and also gated by VS Code's own `#telemetry.telemetryLevel#` setting — never sent if that's off. Never includes file names, entity names, workspace paths, or file contents. Run `LoreFountain: Show Telemetry Queue` to see exactly what's queued to send, or `LoreFountain: Disable Telemetry` to turn this off and clear the queue."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "lorefountain.config.json",
        "url": "./resources/lorefountain.config.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lorefountain",
          "title": "LoreFountain",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "lorefountain": [
        {
          "id": "lorefountain.worldView",
          "name": "World"
        },
        {
          "id": "lorefountain.scriptsView",
          "name": "Scripts"
        },
        {
          "id": "lorefountain.continuityView",
          "name": "Continuity (Pro)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lorefountain.worldView",
        "contents": "Open a folder with a LoreFountain project to see it here.\n\n[Try LoreFountain (Sample Workspace)](command:lorefountain.tryLoreFountain)\n\n[Install a Demo World...](command:lorefountain.installDemo)"
      },
      {
        "view": "lorefountain.scriptsView",
        "contents": "Open a folder with a LoreFountain project to see it here.\n\n[Try LoreFountain (Sample Workspace)](command:lorefountain.tryLoreFountain)\n\n[Install a Demo World...](command:lorefountain.installDemo)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lorefountain.reindexWorkspace",
          "when": "view == lorefountain.worldView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.openSettings",
          "when": "view == lorefountain.worldView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.showEntityGraph",
          "when": "view == lorefountain.worldView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.showBrokenReferences",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.structuredSearch",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.exportStoryBible",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.showEntityGraphHelp",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.showStoryBibleHelp",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.checkFileUpdates",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.migrateExistingLore",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.newScript",
          "when": "view == lorefountain.scriptsView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.showWorldViewHelp",
          "when": "view == lorefountain.worldView",
          "group": "navigation@9"
        },
        {
          "command": "lorefountain.showScriptsViewHelp",
          "when": "view == lorefountain.scriptsView",
          "group": "navigation@9"
        },
        {
          "command": "lorefountain.showContinuityViewHelp",
          "when": "view == lorefountain.continuityView",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "lorefountain.exportTranscript",
          "when": "editorLangId == fountain",
          "group": "navigation"
        },
        {
          "command": "lorefountain.exportBBCRadioScript",
          "when": "editorLangId == fountain",
          "group": "navigation"
        },
        {
          "command": "lorefountain.exportCueSheet",
          "when": "editorLangId == fountain",
          "group": "navigation"
        },
        {
          "command": "lorefountain.exportShotList",
          "when": "editorLangId == fountain",
          "group": "navigation"
        },
        {
          "command": "lorefountain.showBBCRadioScriptHelp",
          "when": "editorLangId == fountain",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.showCueSheetHelp",
          "when": "editorLangId == fountain",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.showShotListHelp",
          "when": "editorLangId == fountain",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.showAssetManifestHelp",
          "when": "activeCustomEditorId == 'lorefountain.assetManifest'",
          "group": "navigation@9"
        },
        {
          "command": "lorefountain.showStoryCardHelp",
          "when": "activeCustomEditorId == 'lorefountain.storyCard'",
          "group": "navigation@9"
        },
        {
          "command": "lorefountain.showStoryOverviewHelp",
          "when": "activeCustomEditorId == 'lorefountain.storyOverview'",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "lorefountain.newCharacter",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.character",
          "group": "inline"
        },
        {
          "command": "lorefountain.newLocation",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.location",
          "group": "inline"
        },
        {
          "command": "lorefountain.newFaction",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.faction",
          "group": "inline"
        },
        {
          "command": "lorefountain.newObject",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.object",
          "group": "inline"
        },
        {
          "command": "lorefountain.newConcept",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.concept",
          "group": "inline"
        },
        {
          "command": "lorefountain.newArc",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.arc",
          "group": "inline"
        },
        {
          "command": "lorefountain.newGlossaryTerm",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.glossary",
          "group": "inline"
        },
        {
          "command": "lorefountain.newEvent",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.timeline",
          "group": "inline"
        },
        {
          "command": "lorefountain.newNote",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.notes",
          "group": "inline"
        },
        {
          "command": "lorefountain.promoteNoteToEntity",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.note",
          "group": "inline"
        },
        {
          "command": "lorefountain.renameEntity",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.entity",
          "group": "7_modification"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "lorefountain.gettingStarted",
        "title": "Get Started with LoreFountain",
        "description": "Link your Fountain scripts to a structured, persistent world — in four steps.",
        "steps": [
          {
            "id": "tryLoreFountain",
            "title": "Try a Sample World",
            "description": "See LoreFountain working before touching your own project — this scaffolds a small sample workspace (two entities, a glossary term, and a script) and opens it.\n[Try LoreFountain](command:lorefountain.tryLoreFountain)",
            "media": {
              "markdown": "resources/walkthrough/try-sample.md"
            },
            "completionEvents": [
              "onCommand:lorefountain.tryLoreFountain"
            ]
          },
          {
            "id": "createEntity",
            "title": "Create Your First Entity",
            "description": "Entities are the characters, locations, factions, objects, concepts, and arcs of your world — each one a plain Markdown file. Create one from the Command Palette or the World view.\n[New Character](command:lorefountain.newCharacter)",
            "media": {
              "markdown": "resources/walkthrough/create-entity.md"
            },
            "completionEvents": [
              "onCommand:lorefountain.newCharacter",
              "onCommand:lorefountain.newLocation",
              "onCommand:lorefountain.newFaction",
              "onCommand:lorefountain.newObject",
              "onCommand:lorefountain.newConcept",
              "onCommand:lorefountain.newArc"
            ]
          },
          {
            "id": "linkInScript",
            "title": "Link It in a Script",
            "description": "Open a `.fountain` script and reference your entity by name — as a character cue, in an action line, or wrapped in `[[double brackets]]`. LoreFountain finds it automatically; hover any recognized mention to preview its Story Card.",
            "media": {
              "markdown": "resources/walkthrough/link-in-script.md"
            }
          },
          {
            "id": "browseWorld",
            "title": "Browse Your World",
            "description": "The World view lists every entity and glossary term by category, with backlinks showing everywhere each one is mentioned.\n[Open the World View](command:lorefountain.worldView.focus)",
            "media": {
              "markdown": "resources/walkthrough/browse-world.md"
            },
            "completionEvents": [
              "onView:lorefountain.worldView"
            ]
          },
          {
            "id": "installDemo",
            "title": "Explore a Full Demo World",
            "description": "Want to see LoreFountain used at real scale instead of a tiny sample? Download a finished demo project — dozens of entities, a full season of scripts — and open it in a new window.\n[Install a Demo](command:lorefountain.installDemo)",
            "media": {
              "markdown": "resources/walkthrough/install-demo.md"
            },
            "completionEvents": [
              "onCommand:lorefountain.installDemo"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.js",
    "build:obfuscate-balanced": "node esbuild.js --production --obfuscate=balanced",
    "build:obfuscate-off": "node esbuild.js --production --obfuscate=off",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit && npm run typecheck:pro-webview",
    "typecheck:pro-webview": "node -e \"const fs=require('fs');if(fs.existsSync('pro/src/webview/tsconfig.json')){require('child_process').execSync('tsc --noEmit -p pro/src/webview/tsconfig.json',{stdio:'inherit'})}\"",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "docx": "^9.8.1",
    "fountain-js": "^1.2.4",
    "markdown-it": "^15.0.0",
    "sql.js": "^1.14.2",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cytoscape": "^3.21.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.4",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "javascript-obfuscator": "^5.8.0",
    "ovsx": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.1"
  },
  "galleryBanner": {
    "color": "#1e2a38",
    "theme": "dark"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "LoreFountain reads and writes project files on disk and needs a local folder."
    }
  },
  "funding": {
    "type": "individual",
    "url": "https://www.allstonetech.com/support?source=lorefountain"
  }
}
