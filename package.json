{
  "name": "lorefountain",
  "displayName": "LoreFountain",
  "description": "A Fountain-native worldbuilding layer for VS Code: link character cues and scene headings to structured entity files with typed relationships, hover previews, and backlinks.",
  "version": "0.0.1",
  "publisher": "allstonetech",
  "author": "the project owner (All Stone Tech)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllStoneTech/lorefountain.git"
  },
  "bugs": {
    "url": "https://github.com/AllStoneTech/lorefountain/issues"
  },
  "homepage": "https://github.com/AllStoneTech/lorefountain#readme",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fountain",
    "screenwriting",
    "worldbuilding",
    "audio drama",
    "markdown"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.fountain",
    "workspaceContains:lorefountain.config.json",
    "onLanguage:fountain"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fountain",
        "extensions": [
          ".fountain",
          ".spmd"
        ],
        "aliases": [
          "Fountain"
        ],
        "configuration": "./resources/fountain-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fountain",
        "scopeName": "text.fountain",
        "path": "./resources/fountain.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fountain",
        "path": "./resources/fountain-cues.code-snippets"
      }
    ],
    "configurationDefaults": {
      "[fountain]": {
        "editor.wordWrap": "on"
      }
    },
    "commands": [
      {
        "command": "lorefountain.reindexWorkspace",
        "title": "Rebuild Index",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.initializeWorkspace",
        "title": "Initialize Workspace",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newCharacter",
        "title": "New Character",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newLocation",
        "title": "New Location",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newFaction",
        "title": "New Faction",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newObject",
        "title": "New Object",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newConcept",
        "title": "New Concept",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newArc",
        "title": "New Arc",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newGlossaryTerm",
        "title": "New Glossary Term",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newNote",
        "title": "New Note",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newEvent",
        "title": "New Event",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.newScript",
        "title": "New Script",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.promoteNoteToEntity",
        "title": "Promote Note to Entity",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.renameEntity",
        "title": "Rename Entity",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.showBrokenReferences",
        "title": "Show Broken References",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.exportTranscript",
        "title": "Export Transcript",
        "category": "LoreFountain",
        "icon": "$(book)"
      },
      {
        "command": "lorefountain.structuredSearch",
        "title": "Structured Search",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.tryLoreFountain",
        "title": "Try LoreFountain (Sample Workspace)",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.migrateExistingLore",
        "title": "Migrate Existing Lore",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.viewAsOfEpisode",
        "title": "View As of Episode (Pro)",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.enterLicenseKey",
        "title": "Enter License Key",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.showLicenseStatus",
        "title": "Show License Status",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.clearLicenseKey",
        "title": "Remove License Key",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.openSettings",
        "title": "Settings",
        "category": "LoreFountain",
        "icon": "$(gear)"
      },
      {
        "command": "lorefountain.showWorldViewHelp",
        "title": "World View: How to Use This View",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showScriptsViewHelp",
        "title": "Scripts View: How to Use This View",
        "category": "LoreFountain",
        "icon": "$(question)"
      },
      {
        "command": "lorefountain.showContinuityViewHelp",
        "title": "Continuity View (Pro): How to Use This View",
        "category": "LoreFountain",
        "icon": "$(question)"
      }
    ],
    "customEditors": [
      {
        "viewType": "lorefountain.storyOverview",
        "displayName": "LoreFountain Story Overview",
        "selector": [
          {
            "filenamePattern": "**/world/OVERVIEW.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "lorefountain.storyCard",
        "displayName": "LoreFountain Story Card",
        "selector": [
          {
            "filenamePattern": "**/world/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "LoreFountain",
      "properties": {
        "lorefountain.hover.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a Story Card preview on hover over a recognized entity/glossary mention in `.fountain` scripts. Disable if you'd rather rely on another extension's hover."
        },
        "lorefountain.completion.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer entity/glossary name autocomplete after typing `[[` in scripts and world Markdown files (Spec §6, §13.2)."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "lorefountain.config.json",
        "url": "./resources/lorefountain.config.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lorefountain",
          "title": "LoreFountain",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "lorefountain": [
        {
          "id": "lorefountain.worldView",
          "name": "World"
        },
        {
          "id": "lorefountain.scriptsView",
          "name": "Scripts"
        },
        {
          "id": "lorefountain.continuityView",
          "name": "Continuity (Pro)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lorefountain.reindexWorkspace",
          "when": "view == lorefountain.worldView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.openSettings",
          "when": "view == lorefountain.worldView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.showBrokenReferences",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.structuredSearch",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.migrateExistingLore",
          "when": "view == lorefountain.worldView",
          "group": "9_lorefountain"
        },
        {
          "command": "lorefountain.newScript",
          "when": "view == lorefountain.scriptsView",
          "group": "navigation"
        },
        {
          "command": "lorefountain.showWorldViewHelp",
          "when": "view == lorefountain.worldView",
          "group": "navigation@9"
        },
        {
          "command": "lorefountain.showScriptsViewHelp",
          "when": "view == lorefountain.scriptsView",
          "group": "navigation@9"
        },
        {
          "command": "lorefountain.showContinuityViewHelp",
          "when": "view == lorefountain.continuityView",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "lorefountain.exportTranscript",
          "when": "editorLangId == fountain",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lorefountain.newCharacter",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.character",
          "group": "inline"
        },
        {
          "command": "lorefountain.newLocation",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.location",
          "group": "inline"
        },
        {
          "command": "lorefountain.newFaction",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.faction",
          "group": "inline"
        },
        {
          "command": "lorefountain.newObject",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.object",
          "group": "inline"
        },
        {
          "command": "lorefountain.newConcept",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.concept",
          "group": "inline"
        },
        {
          "command": "lorefountain.newArc",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.arc",
          "group": "inline"
        },
        {
          "command": "lorefountain.newGlossaryTerm",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.glossary",
          "group": "inline"
        },
        {
          "command": "lorefountain.newEvent",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.timeline",
          "group": "inline"
        },
        {
          "command": "lorefountain.newNote",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.category.notes",
          "group": "inline"
        },
        {
          "command": "lorefountain.promoteNoteToEntity",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.note",
          "group": "inline"
        },
        {
          "command": "lorefountain.renameEntity",
          "when": "view == lorefountain.worldView && viewItem == lorefountain.entity",
          "group": "7_modification"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "lorefountain.gettingStarted",
        "title": "Get Started with LoreFountain",
        "description": "Link your Fountain scripts to a structured, persistent world — in four steps.",
        "steps": [
          {
            "id": "tryLoreFountain",
            "title": "Try a Sample World",
            "description": "See LoreFountain working before touching your own project — this scaffolds a small sample workspace (two entities, a glossary term, and a script) and opens it.\n[Try LoreFountain](command:lorefountain.tryLoreFountain)",
            "media": {
              "markdown": "resources/walkthrough/try-sample.md"
            },
            "completionEvents": [
              "onCommand:lorefountain.tryLoreFountain"
            ]
          },
          {
            "id": "createEntity",
            "title": "Create Your First Entity",
            "description": "Entities are the characters, locations, factions, objects, concepts, and arcs of your world — each one a plain Markdown file. Create one from the Command Palette or the World view.\n[New Character](command:lorefountain.newCharacter)",
            "media": {
              "markdown": "resources/walkthrough/create-entity.md"
            },
            "completionEvents": [
              "onCommand:lorefountain.newCharacter",
              "onCommand:lorefountain.newLocation",
              "onCommand:lorefountain.newFaction",
              "onCommand:lorefountain.newObject",
              "onCommand:lorefountain.newConcept",
              "onCommand:lorefountain.newArc"
            ]
          },
          {
            "id": "linkInScript",
            "title": "Link It in a Script",
            "description": "Open a `.fountain` script and reference your entity by name — as a character cue, in an action line, or wrapped in `[[double brackets]]`. LoreFountain finds it automatically; hover any recognized mention to preview its Story Card.",
            "media": {
              "markdown": "resources/walkthrough/link-in-script.md"
            }
          },
          {
            "id": "browseWorld",
            "title": "Browse Your World",
            "description": "The World view lists every entity and glossary term by category, with backlinks showing everywhere each one is mentioned.\n[Open the World View](command:lorefountain.worldView.focus)",
            "media": {
              "markdown": "resources/walkthrough/browse-world.md"
            },
            "completionEvents": [
              "onView:lorefountain.worldView"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "package": "vsce package"
  },
  "dependencies": {
    "fountain-js": "^1.2.4",
    "markdown-it": "^15.0.0",
    "sql.js": "^1.14.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
