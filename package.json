      },
      {
        "command": "lorefountain.showEntityGraph",
        "title": "Show Entity Graph (Pro)",
        "category": "LoreFountain",
        "icon": "$(graph)"
      },
      {
        "command": "lorefountain.exportStoryBible",
        "title": "Export Story Bible (Pro)",
        "category": "LoreFountain",
        "icon": "$(export)"
      },
      {
        "command": "lorefountain.exportBBCRadioScript",
        "title": "Export BBC Radio Script (Pro)",
        "category": "LoreFountain",
        "icon": "$(radio-tower)"
      },
      {
        "command": "lorefountain.exportCueSheet",
        "title": "Export Cue Sheet (Pro)",
        "category": "LoreFountain",
        "icon": "$(checklist)"
      },
      {
        "command": "lorefountain.exportShotList",
        "title": "Export Shot List (Pro)",
        "category": "LoreFountain",
        "icon": "$(device-camera)"
      },
      {
        "command": "lorefountain.enterLicenseKey",
        "title": "Enter License Key",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.showLicenseStatus",
        "title": "Show License Status",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.clearLicenseKey",
        "title": "Remove License Key",
        "category": "LoreFountain"
      },
      {
        "command": "lorefountain.openSettings",
        "title": "Settings",
        "category": "LoreFountain",
        "icon": "$(gear)"
      },
      {
