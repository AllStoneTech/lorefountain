# Dependencies
node_modules/

# Build output
dist/
out/
*.vsix

# Bundled headless-validator script — regenerated by esbuild.js from
# src/cli/validate.ts on every build, not hand-edited or committed
resources/agents/validate.js

# Test runner
.vscode-test/
coverage/

# Rebuildable local index (Spec Section 2.2) — machine-local, never versioned
*.lorefountain.db
*.lorefountain.db-journal
.lorefountain/

# Cue sidecars (Spec Section 15) — derived from scripts, regenerated on every reindex
*.cues.json

# OS / editor cruft
.DS_Store
Thumbs.db
