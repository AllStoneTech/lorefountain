# Everything here is excluded from the packaged .vsix.
# The bundled output in dist/ is the only code shipped.

# Every dot-directory: editor, CI, and local tooling config
.*/**
src/**
test/**
out/**
node_modules/**
docs/**
coverage/**
imports/**
pro/**
demos/**

.gitignore
.gitmodules
.vscodeignore
esbuild.js
eslint.config.mjs
tsconfig.json

**/*.ts
**/*.map
